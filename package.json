{
  "name": "portfolio-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "test:e2e": "nuxt generate && playwright test",
    "test:e2e:update": "nuxt generate && playwright test --update-snapshots=changed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:typecheck": "tsc -p tests/tsconfig.json",
    "test:a11y": "nuxt generate && playwright test a11y",
    "audit": "pnpm dlx audit-ci@^7 --config ./audit-ci.json",
    "prepare": "husky"
  },
  "dependencies": {
    "@vite-pwa/nuxt": "^1.1.1",
    "axios": "^1.20.0",
    "canvas-sketch-util": "^1.10.0",
    "d3": "^7.9.0",
    "d3-svg-legend": "^2.25.6",
    "gsap": "^3.15.0",
    "lodash": "^4.18.1",
    "nice-color-palettes": "^4.0.0",
    "nuxt": "^4.6.0",
    "nuxt-gtag": "^5.0.0",
    "opentype.js": "^2.0.0",
    "p5": "^1.2.0",
    "particles.js": "^2.0.0",
    "prismjs": "^1.30.0",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.4.3",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@nuxt/eslint": "^1.17.0",
    "@playwright/test": "1.56.1",
    "@types/node": "24.13.6",
    "@types/p5": "^0.9.1",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "prettier": "^2.8.8",
    "sass": "^1.105.1",
    "sirv-cli": "^3.0.1",
    "typescript": "~6.0.3"
  }
}
