    "d3-svg-legend": "^2.25.6",
    "gsap": "^3.15.0",
    "lodash": "^4.18.1",
    "nice-color-palettes": "^4.0.0",
    "nuxt": "^4.6.4",
    "nuxt-gtag": "^5.0.0",
    "opentype.js": "^2.0.0",
    "p5": "^1.2.0",
    "particles.js": "^2.0.0",
    "prismjs": "^1.30.0",
    "simplex-noise": "^4.0.3",
    "three": "^0.186.1",
    "three-stdlib": "^2.36.1",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.4.3",
