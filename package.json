{
  "name": "portfolio-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.28.2",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "test": "pnpm test:stories && pnpm test:a11y",
    "test:stories": "vitest run --project=storybook",
    "test:a11y": "nuxt generate && playwright test",
    "visual-diff": "bash tests/visual/diff.sh",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "audit": "pnpm dlx audit-ci@^7 --config ./audit-ci.json",
    "prepare": "husky"
  },
  "dependencies": {
